datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MessageCategory {
  INCIDENT
  TASK
  DECISION
  KNOWLEDGE
  GENERAL_CHAT
  NOISE
}

enum DiscussionStatus {
  PROPOSED
  ACTIVE
  RESOLVED
  ARCHIVED
}
enum DiscussionVisibility {
  PRIVATE
  MEMBERS
  PUBLIC
}
enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
}
enum NotificationType {
  MENTION
  FOLLOW_UP_DUE
  NEW_DISCUSSION
}


model User {
  id           String        @id @default(uuid())
  email        String        @unique
  fullName     String
  phoneJid     String?       @unique
  role         String        @default("member")
  createdAt    DateTime      @default(now())
  messagesSent DeckMessage[] @relation("UserSentMessages")
}

model WhatsAppGroup {
  id          String             @id
  name        String
  isActive    Boolean            @default(true)
  columns     DeckColumn[]
  messages    DeckMessage[]
  discussions DiscussionThread[]
  notifications Notification[]
  matchDecisions MatchDecision[]
  createdAt   DateTime           @default(now())
}

model DeckColumn {
  id        String          @id @default(uuid())
  slug      String
  title     String
  category  MessageCategory
  groupId   String
  group     WhatsAppGroup   @relation(fields: [groupId], references: [id])
  messages  DeckMessage[]
  createdAt DateTime        @default(now())

  @@unique([groupId, slug])
}

model DiscussionThread {
  id             String           @id @default(uuid())
  groupId        String
  group          WhatsAppGroup    @relation(fields: [groupId], references: [id])
  topicKey       String
  title          String
  status         DiscussionStatus @default(ACTIVE)
  visibility     DiscussionVisibility @default(PRIVATE)
  tags           Json?
  summary        String?          @db.Text
  ownerName      String?
  nextAction     String?          @db.Text
  followUpAt     DateTime?
  priority       String?
  messages       DeckMessage[]
  notifications  Notification[]
  corrections    RoutingCorrection[] @relation("CorrectionTarget")
  matchDecisions MatchDecision[]     @relation("MatchDecisionThread")
  lastActivityAt DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([groupId, topicKey])
  @@index([groupId, status, lastActivityAt(sort: Desc)])
}

model DeckMessage {
  id              String            @id
  groupId         String
  group           WhatsAppGroup     @relation(fields: [groupId], references: [id])
  columnId        String?
  column          DeckColumn?       @relation(fields: [columnId], references: [id])
  senderJid       String
  senderUserId    String?
  senderUser      User?             @relation("UserSentMessages", fields: [senderUserId], references: [id])
  senderName      String
  content         String            @db.Text
  category        MessageCategory   @default(GENERAL_CHAT)
  discussionId    String?
  discussion      DiscussionThread? @relation(fields: [discussionId], references: [id])
  parentMessageId String?
  metadata        Json?
  isOutbound      Boolean           @default(false)
  timestamp       DateTime
  media           MediaAsset?
  createdAt       DateTime          @default(now())
  corrections    RoutingCorrection[]
  matchDecision  MatchDecision?

  @@index([groupId, columnId, createdAt(sort: Desc)])
  @@index([discussionId, createdAt(sort: Desc)])
  @@index([parentMessageId])
}

model MediaAsset {
  id        String      @id @default(uuid())
  messageId String      @unique
  message   DeckMessage @relation(fields: [messageId], references: [id])
  kind      MediaKind
  mimeType  String
  fileName  String
  sizeBytes Int
  createdAt DateTime    @default(now())
}

model Notification {
  id           String            @id @default(uuid())
  groupId      String
  group        WhatsAppGroup     @relation(fields: [groupId], references: [id])
  type         NotificationType
  title        String
  body         String?           @db.Text
  discussionId String?
  discussion   DiscussionThread? @relation(fields: [discussionId], references: [id])
  read         Boolean           @default(false)
  createdAt    DateTime          @default(now())

  @@index([groupId, read, createdAt(sort: Desc)])
}

/// Corrección manual de enrutado. Además de arreglar el hilo, deja un caso
/// etiquetado por humano para evaluar cambios futuros del clasificador.
model RoutingCorrection {
  id           String            @id @default(uuid())
  groupId      String
  messageId    String
  message      DeckMessage       @relation(fields: [messageId], references: [id])
  fromThreadId String?
  toThreadId   String?
  toThread     DiscussionThread? @relation("CorrectionTarget", fields: [toThreadId], references: [id])
  correctedBy  String?
  createdAt    DateTime          @default(now())

  @@index([groupId, createdAt(sort: Desc)])
  @@index([messageId])
}

/// Una fila por mensaje procesado por el pipeline de enrutado: qué decidió el matcher,
/// con qué confianza y bajo qué versión de prompt. Cruzado con RoutingCorrection
/// (messageId) da la tasa de acierto real por versión de prompt, sin depender de que
/// alguien reporte el error a ojo.
model MatchDecision {
  id              String            @id @default(uuid())
  groupId         String
  group           WhatsAppGroup     @relation(fields: [groupId], references: [id])
  messageId       String            @unique
  message         DeckMessage       @relation(fields: [messageId], references: [id])
  promptVersion   String
  /// "citation" (determinista, cita a un mensaje con hilo) | "typesafe" (matcher
  /// probabilístico) | "model_comparison" (comparativa de modelos) | "unresolved_reply" (cita sin padre) | "noise" (fue a Sin tema)
  method          String
  category        MessageCategory
  matchedThreadId String?
  matchedThread   DiscussionThread? @relation("MatchDecisionThread", fields: [matchedThreadId], references: [id])
  isNewTopic      Boolean
  confidence      Float?
  candidateCount  Int
  createdAt       DateTime          @default(now())

  @@index([groupId, createdAt(sort: Desc)])
  @@index([promptVersion])
}
